{
    "name": "@layerzerolabs/oft-solana-contracts",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "files": [
        "src",
        "macros",
        "Cargo.toml",
        "Anchor.toml",
        "rust-toolchain.toml",
        "rustfmt.toml"
    ],
    "scripts": {
        "build": "pnpm resolve-dependencies && pnpm exec lz-tool --script 'cargo build' anchor",
        "build:native": "pnpm resolve-dependencies && pnpm exec lz-tool --docker-platform native --script 'cargo build' anchor",
        "check": "pnpm exec lz-tool --script 'cargo check' anchor",
        "clean": "rm -rf dependencies target",
        "format": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt' anchor",
        "format:check": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt -- --check' anchor",
        "lint": "pnpm resolve-dependencies && pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt -- --check && cargo clippy --all-targets' anchor",
        "resolve-dependencies": "pnpm exec build-utils-rust resolve",
        "test": "pnpm test:rust",
        "test:rust": "pnpm resolve-dependencies && pnpm exec lz-tool --script 'cargo test -p oft --lib --tests' anchor",
        "vendor": "pnpm resolve-dependencies"
    },
    "dependencies": {
        "@layerzerolabs/framework-solana-anchor-trait": "workspace:*",
        "@layerzerolabs/oapp-solana-contracts": "workspace:*"
    },
    "devDependencies": {
        "@layerzerolabs/build-utils-rust": "workspace:*",
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "@layerzerolabs/vm-tooling-solana": "workspace:*"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "implicitDependencies": {
        "@layerzerolabs/framework-solana-anchor-trait": "workspace:*",
        "@layerzerolabs/oapp-solana-contracts": "workspace:*"
    }
}
