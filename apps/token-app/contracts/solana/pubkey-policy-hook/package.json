{
    "name": "@layerzerolabs/pubkey-policy-hook-solana-contracts",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "files": [
        "programs",
        "scripts",
        "Anchor.toml",
        "Cargo.toml",
        "rust-toolchain.toml",
        "rustfmt.toml",
        "turbo.json",
        "turbo-snapshot.lock.json",
        "!**/target/**",
        "!**/*-keypair.json"
    ],
    "scripts": {
        "allow-read-write": "[ -z \"$CI\" ] || sudo chmod -R a+rwx ./target",
        "build": "pnpm resolve-dependencies && pnpm exec lz-tool --script 'sh scripts/build.sh' anchor && pnpm build:check && pnpm allow-read-write",
        "build:check": "sh scripts/check-build-outputs.sh",
        "format": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt --all' anchor",
        "format:check": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt --all -- --check' anchor",
        "lint": "pnpm resolve-dependencies && pnpm format:check && pnpm exec lz-tool --script 'cargo clippy --workspace --all-targets --locked -- -D warnings' anchor",
        "resolve-dependencies": "pnpm exec build-utils-rust resolve",
        "test": "pnpm test:rust",
        "test:rust": "pnpm resolve-dependencies && pnpm exec lz-tool --script 'cargo test --workspace --locked' anchor",
        "vendor": "pnpm resolve-dependencies"
    },
    "dependencies": {
        "@layerzerolabs/program-id-solana-contracts": "workspace:*",
        "@layerzerolabs/pubkey-policy-solana-contracts": "workspace:*"
    },
    "devDependencies": {
        "@layerzerolabs/build-utils-rust": "workspace:*",
        "@layerzerolabs/vm-tooling-solana": "workspace:*"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "implicitDependencies": {
        "@layerzerolabs/program-id-solana-contracts": "workspace:*",
        "@layerzerolabs/pubkey-policy-solana-contracts": "workspace:*"
    }
}
