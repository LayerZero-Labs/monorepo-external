{
    "name": "@layerzerolabs/proxy-v5-6-evm-contracts",
    "version": "0.0.0",
    "private": false,
    "description": "",
    "license": "MIT",
    "scripts": {
        "build": "pnpm compile:evm && pnpm compile:zksync && pnpm compile:tron && pnpm flatten:all",
        "clean": "rm -rf ./node_modules .turbo ./dist && pnpm generated:clean",
        "compile:evm": "pnpm lz-tool hardhat compile --config ./hardhat.config.js",
        "compile:tron": "pnpm lz-tool hardhat compile --config ./hardhat.config.js --network tron-mainnet",
        "compile:zksync": "pnpm lz-tool hardhat compile --config ./hardhat.config.js --network zksync-mainnet",
        "flatten:all": "mkdir -p ./artifacts-flattened-contracts/contracts && pnpm flatten:proxyadmin2step && pnpm flatten:transparentupgradeableproxy2step",
        "flatten:proxyadmin2step": "pnpm exec lz-tool -e sol_merger.sh hardhat ./contracts/ProxyAdmin2Step.sol ./artifacts-flattened-contracts/contracts/ProxyAdmin2Step.flattened.sol",
        "flatten:transparentupgradeableproxy2step": "pnpm exec lz-tool -e sol_merger.sh hardhat ./contracts/TransparentUpgradeableProxy2Step.sol ./artifacts-flattened-contracts/contracts/TransparentUpgradeableProxy2Step.flattened.sol",
        "generated:clean": "rm -rf ./artifacts* ./hh-cache* ./out ./cache",
        "lint": "solhint --config solhint.config.js 'contracts/**/*.sol' 'test/**/*.sol' --fix --noPrompt",
        "test": "pnpm lz-tool forge test"
    },
    "devDependencies": {
        "@layerzerolabs/hardhat-tron": "catalog:",
        "@layerzerolabs/solhint-configuration": "workspace:*",
        "@layerzerolabs/toolbox-foundry": "catalog:",
        "@layerzerolabs/vm-tooling-evm": "workspace:*",
        "@matterlabs/hardhat-zksync-solc": "catalog:",
        "@openzeppelin/contracts": "catalog:proxy-v5-6",
        "hardhat-deploy": "catalog:",
        "solhint": "catalog:"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
