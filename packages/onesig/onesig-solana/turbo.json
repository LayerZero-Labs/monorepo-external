{
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "!dependencies/**",
                "!**/*.md",
                "!**/LICENSE",
                "!audits/**",
                "!test/**",
                "!tsconfig.json",
                "!vitest.config.ts",
                "!eslint.config.js"
            ],
            "outputs": ["target/deploy/*.so", "build/**"],
            "dependsOn": ["vendor"]
        },
        "test": {
            "dependsOn": ["build", "lint", "^build"]
        }
    }
}
