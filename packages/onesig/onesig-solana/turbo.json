{
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "!dependencies/**",
                "!**/*.md",
                "!**/LICENSE",
                "!audits/**",
                "!test/**",
                "!tsconfig.json",
                "!vitest.config.ts",
                "!eslint.config.js"
            ],
            "outputs": ["dependencies/**", "target/deploy/*.so", "build/**"]
        },
        "test": {
            "dependsOn": ["build", "lint"]
        }
    }
}
