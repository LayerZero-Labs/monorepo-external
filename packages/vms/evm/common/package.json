        "@layerzerolabs/evm-gas-limits": "workspace:*",
        "@layerzerolabs/function-pointer": "workspace:*",
        "@layerzerolabs/gated-transaction": "workspace:*",
        "@layerzerolabs/layerzero-definitions": "workspace:*",
        "@layerzerolabs/static-chain-info": "workspace:*",
        "@layerzerolabs/typescript-utils": "workspace:*",
        "abitype": "catalog:",
        "axios": "catalog:",
        "viem": "catalog:",
        "zod": "catalog:"
