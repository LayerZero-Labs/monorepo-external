{
    "name": "@layerzerolabs/chain-utils",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "tsup",
        "lint": "eslint . --max-warnings 0 || (eslint . --fix --max-warnings 0 && false)",
        "test": "vitest --run --pass-with-no-tests --typecheck"
    },
    "dependencies": {
        "@initia/initia.js": "catalog:",
        "@layerzerolabs/address-utils-stellar": "workspace:*",
        "@layerzerolabs/address-utils-ton": "workspace:*",
        "@layerzerolabs/common-canton": "workspace:*",
        "@layerzerolabs/common-chain-model": "workspace:*",
        "@layerzerolabs/common-encoding-utils": "workspace:*",
        "@layerzerolabs/layerzero-definitions": "workspace:*",
        "@layerzerolabs/static-chain-info": "workspace:*",
        "@layerzerolabs/typescript-utils": "workspace:*",
        "@stellar/stellar-sdk": "catalog:",
        "@ton/core": "catalog:",
        "bs58": "catalog:"
    },
    "devDependencies": {
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "@layerzerolabs/vitest-configuration": "workspace:*",
        "tsup": "catalog:",
        "vitest": "catalog:"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
