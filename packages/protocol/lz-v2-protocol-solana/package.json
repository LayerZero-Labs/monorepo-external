{
    "name": "@layerzerolabs/lz-v2-protocol-solana",
    "version": "0.0.0",
    "private": false,
    "license": "LZBL-1.3",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./v3": {
            "types": "./dist/v3.d.ts",
            "import": "./dist/v3.js",
            "default": "./dist/v3.js"
        },
        "./test-setup": {
            "types": "./tests/setup.ts",
            "default": "./tests/setup.ts"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "deployments/**/*",
        "dist/**/*",
        "src/**/*",
        "tests/setup.ts"
    ],
    "scripts": {
        "build": "pnpm exec copy-artifacts && pnpm generate && tsup",
        "generate": "pnpm pre-generate-clean && mkdir -p ./src/generated && tsx ./src/scripts/generator.ts",
        "pre-generate-clean": "find ./src/generated -name '*.ts' -not -name 'index.ts' -delete || true",
        "test": "vitest run tests/plan-v3.test.ts tests/transaction-v1.test.ts tests/transport-v1.test.ts",
        "test:regenerate-features": "mkdir -p target/programs && tsx ./src/scripts/generate-features.ts"
    },
    "dependencies": {
        "@layerzerolabs/common-encoding-utils": "workspace:*",
        "@layerzerolabs/lz-corekit-solana": "catalog:",
        "@layerzerolabs/lz-definitions": "catalog:",
        "@layerzerolabs/lz-serdes": "catalog:",
        "@layerzerolabs/lz-v2-protocol-solana-v3": "workspace:*",
        "@layerzerolabs/protocol-codecs-v2": "workspace:*",
        "@metaplex-foundation/mpl-toolbox": "catalog:",
        "@metaplex-foundation/umi": "catalog:",
        "@metaplex-foundation/umi-eddsa-web3js": "catalog:",
        "@metaplex-foundation/umi-program-repository": "catalog:",
        "@metaplex-foundation/umi-web3js-adapters": "catalog:",
        "@noble/hashes": "catalog:",
        "@solana/kit": "catalog:",
        "@solana/spl-token": "catalog:",
        "@solana/web3.js": "catalog:",
        "bn.js": "catalog:",
        "tiny-invariant": "catalog:"
    },
    "devDependencies": {
        "@codama/nodes-from-anchor": "catalog:",
        "@codama/renderers": "catalog:",
        "@codama/renderers-js": "catalog:",
        "@codama/renderers-js-umi": "catalog:",
        "@coral-xyz/anchor": "catalog:",
        "@ethersproject/solidity": "catalog:",
        "@layerzerolabs/artifacts-copier": "workspace:*",
        "@layerzerolabs/layerzero-v2-solana": "workspace:*",
        "@layerzerolabs/repo-utils": "workspace:*",
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "@layerzerolabs/vm-tooling-solana": "workspace:*",
        "@metaplex-foundation/umi-bundle-defaults": "catalog:",
        "@noble/secp256k1": "catalog:",
        "@types/bn.js": "catalog:",
        "axios": "catalog:",
        "codama": "catalog:",
        "tsup": "catalog:",
        "vitest": "catalog:",
        "zx": "catalog:"
    },
    "publishConfig": {
        "access": "restricted",
        "registry": "https://registry.npmjs.org/"
    }
}
