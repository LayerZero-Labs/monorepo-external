{
    "name": "@layerzerolabs/layerzero-v2-solana",
    "version": "0.0.0",
    "private": false,
    "license": "LZBL-1.3",
    "files": [
        "target/deploy",
        "target/idl"
    ],
    "scripts": {
        "allow-read-write": "[ -z \"$CI\" ] || sudo chmod -R a+rwx ./target",
        "build": "pnpm exec lz-tool --anchor-version 0.29.0 --solana-version 1.17.31 anchor build && pnpm allow-read-write",
        "build:native": "pnpm exec lz-tool --docker-platform native --anchor-version 0.29.0 --solana-version 1.17.31 anchor build && pnpm allow-read-write",
        "test": "pnpm exec lz-tool --anchor-version 0.29.0 --solana-version 1.17.31 --script 'cargo test --lib --tests' anchor"
    },
    "devDependencies": {
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "@layerzerolabs/vm-tooling-solana": "workspace:*"
    },
    "publishConfig": {
        "access": "restricted",
        "registry": "https://registry.npmjs.org/"
    }
}
