{
    "name": "@layerzerolabs/framework-solana-anchor-trait",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "files": [
        "src",
        "tests",
        "examples",
        "reference",
        "Cargo.toml",
        "rust-toolchain.toml",
        "rustfmt.toml"
    ],
    "scripts": {
        "allow-read-write": "[ -z \"$CI\" ] || sudo chmod -R a+rwx ./target",
        "build": "pnpm build:lib && pnpm build:example && pnpm allow-read-write",
        "build:example": "pnpm exec lz-tool --script 'anchor build --no-idl --ignore-keys' anchor",
        "build:example:native": "pnpm exec lz-tool --docker-platform native --script 'anchor build --no-idl --ignore-keys' anchor",
        "build:lib": "pnpm exec lz-tool --script 'cargo build' anchor",
        "build:lib:native": "pnpm exec lz-tool --docker-platform native --script 'cargo build' anchor",
        "build:native": "pnpm build:lib:native && pnpm build:example:native && pnpm allow-read-write",
        "check": "pnpm exec lz-tool --script 'cargo check' anchor",
        "clean": "rm -rf target",
        "format": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt' anchor",
        "format:check": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt -- --check' anchor",
        "lint": "pnpm exec lz-tool --script 'cargo +nightly-2025-06-01 fmt -- --check && cargo clippy --all-targets' anchor",
        "test": "pnpm test:rust && pnpm test:example",
        "test:example": "pnpm test:example:ellipse && pnpm test:example:triangle",
        "test:example:ellipse": "pnpm exec lz-tool --script 'cargo test-ellipse' anchor",
        "test:example:triangle": "pnpm exec lz-tool --script 'cargo test-triangle' anchor",
        "test:rust": "pnpm exec lz-tool --script 'cargo test -p anchor-trait --lib --tests' anchor"
    },
    "devDependencies": {
        "@layerzerolabs/build-utils-solana": "workspace:*",
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "@layerzerolabs/vm-tooling-solana": "workspace:*"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
