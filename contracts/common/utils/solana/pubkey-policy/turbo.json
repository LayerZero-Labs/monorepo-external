{
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "!dependencies/**",
                "!**/*.md",
                "!programs/**/tests/**",
                "!tests/**"
            ],
            "outputs": ["target/deploy/*.so", "target/idl/**", "target/types/**"],
            "dependsOn": ["vendor"]
        },
        "test": {
            "dependsOn": ["build", "lint", "^build"]
        }
    }
}
