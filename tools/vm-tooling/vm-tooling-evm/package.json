{
    "name": "@layerzerolabs/vm-tooling-evm",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./hardhat-tron": {
            "types": "./docker/evm/hardhat-tron.d.cts",
            "default": "./docker/evm/hardhat-tron.cjs"
        }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "lz-tool": "./bin/lz-tool.js"
    },
    "files": [
        "dist/**/*",
        "bin/**/*",
        "docker/evm/hardhat-tron.*"
    ],
    "scripts": {
        "build": "tsup",
        "generate-github-matrix": "tsx src/scripts/generate-github-matrix.ts",
        "lint": "eslint . --max-warnings 0 || (eslint . --fix --max-warnings 0 && false)",
        "test": "vitest"
    },
    "dependencies": {
        "@layerzerolabs/vm-tooling": "workspace:*",
        "semver": "catalog:"
    },
    "devDependencies": {
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "@layerzerolabs/vitest-configuration": "workspace:*",
        "@types/node": "catalog:",
        "hardhat": "catalog:",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "hardhat": "catalog:"
    },
    "peerDependenciesMeta": {
        "hardhat": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "restricted",
        "registry": "https://registry.npmjs.org/"
    }
}
