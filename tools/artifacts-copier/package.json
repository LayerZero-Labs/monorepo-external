{
    "name": "@layerzerolabs/artifacts-copier",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "copy-artifacts": "./src/copyAllArtifacts.ts"
    },
    "files": [
        "dist/**/*",
        "src/**/*"
    ],
    "scripts": {
        "artifacts:copy": "tsx ./src/copyAllArtifacts.ts",
        "build": "tsup",
        "lint": "eslint . --max-warnings 0 || (eslint . --fix --max-warnings 0 && false)",
        "test": "vitest --run --pass-with-no-tests --typecheck"
    },
    "dependencies": {
        "@layerzerolabs/args": "workspace:*",
        "@layerzerolabs/build-utils-starknet": "workspace:*",
        "@layerzerolabs/layerzero-definitions": "workspace:*",
        "@layerzerolabs/ton-sdk-tools": "catalog:"
    },
    "devDependencies": {
        "@layerzerolabs/tsup-configuration": "workspace:*",
        "@layerzerolabs/typescript-configuration": "workspace:*",
        "prettier": "catalog:",
        "tsup": "catalog:",
        "vitest": "catalog:"
    },
    "publishConfig": {
        "access": "restricted",
        "registry": "https://registry.npmjs.org/"
    }
}
