{
    "extends": "@layerzerolabs/typescript-configuration/tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "module": "ESNext",
        "outDir": "./dist",
        "strictPropertyInitialization": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
