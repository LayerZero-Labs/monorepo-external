{
    "name": "@layerzerolabs/evm-ts-artifacts-generator",
    "version": "0.0.0",
    "private": false,
    "license": "MIT",
    "type": "module",
    "main": "./src/run.ts",
    "module": "./src/run.ts",
    "bin": {
        "generate-ts-artifacts": "./src/run.ts"
    },
    "scripts": {
